{
  "name": "simuforge-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/smoke.test.mjs",
    "check:node": "node scripts/check-node.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run check:node && npm run typecheck && npm run check:boundaries && npm run check:tokens",
    "notices": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.32.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  }
}
